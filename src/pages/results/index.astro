---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryRow from '../../components/EntryRow.astro';
import results from '../../data/results.json';
import { categoryLabel } from '../../lib/categories.mjs';

const sorted = [...results].sort((a, b) =>
  (b.releaseDate || b.datePosted || '').localeCompare(a.releaseDate || a.datePosted || '')
);
---

<BaseLayout
  title="Exam Results"
  description="Declared government exam results — merit lists, scorecards and cut-offs, sourced from official announcements."
  canonicalPath="/results/"
>
  <h1>Exam results</h1>
  <p class="muted">
    {results.length} declared results tracked from official announcements. <a href="/sources">Our sources</a>.
  </p>

  {
    sorted.length === 0 ? (
      <p class="notice">No results published yet. New declarations appear here straight from official announcements.</p>
    ) : (
      <div class="stack">
        {sorted.map((r) => (
          <EntryRow
            href={`/results/${r.slug}`}
            title={r.title}
            meta={[
              r.organization,
              categoryLabel(r.category),
              r.releaseDate ? `Released ${r.releaseDate}` : null,
            ]}
            badge={r.status || 'declared'}
            badgeTone="open"
          />
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
  }
</style>
