---
import BaseLayout from '../layouts/BaseLayout.astro';
import jobs from '../data/jobs.json';
import results from '../data/results.json';
import admits from '../data/admit-cards.json';

const today = new Date().toISOString().slice(0, 10);
const openJobs = jobs
  .filter((j) => !j.lastDate || j.lastDate >= today)
  .sort((a, b) => (a.lastDate || '9999').localeCompare(b.lastDate || '9999'));
const recent = [...jobs]
  .sort((a, b) => (b.datePosted || '').localeCompare(a.datePosted || ''))
  .slice(0, 8);
const byCategory = jobs.reduce((acc, j) => {
  if (j.category) acc[j.category] = (acc[j.category] || 0) + 1;
  return acc;
}, {});
const totalVacancies = jobs.reduce((sum, j) => sum + (Number(j.vacancies) || 0), 0);
---

<BaseLayout>
  <h1>Official Government Job Notifications</h1>
  <p class="muted">
    Every listing is sourced from official government portals and notification PDFs — no news
    rewrites, no filler. Apply only through the official links on each page.
  </p>

  <section class="panel" style="margin-top: 1.25rem;">
    <strong>{openJobs.length}</strong> open jobs ·
    <strong>{results.length}</strong> results ·
    <strong>{admits.length}</strong> admit cards ·
    <strong>{totalVacancies.toLocaleString('en-IN')}</strong> vacancies tracked
  </section>

  {
    results.length > 0 ? (
      <>
        <h2>Latest results</h2>
        {results.slice(0, 5).map((r) => (
          <a class="job-card" href={`/results/${r.slug}`}>
            <h3>{r.title}</h3>
            <div class="meta">
              <span>{r.organization}</span>
              {r.releaseDate ? <span>Released: {r.releaseDate}</span> : null}
              <span class="badge open">{r.status || 'declared'}</span>
            </div>
          </a>
        ))}
      </>
    ) : null
  }

  {
    admits.length > 0 ? (
      <>
        <h2>Latest admit cards</h2>
        {admits.slice(0, 5).map((a) => (
          <a class="job-card" href={`/admit-cards/${a.slug}`}>
            <h3>{a.title}</h3>
            <div class="meta">
              <span>{a.organization}</span>
              {a.releaseDate ? <span>Released: {a.releaseDate}</span> : null}
              <span class="badge open">released</span>
            </div>
          </a>
        ))}
      </>
    ) : null
  }

  <h2>Deadline radar</h2>
  {
    openJobs.length === 0 ? (
      <p class="muted">No open notifications yet. The ingestion pipeline is populating this list from official sources.</p>
    ) : (
      openJobs.slice(0, 10).map((job) => (
        <a class="job-card" href={`/jobs/${job.slug}`}>
          <h3>{job.title}</h3>
          <div class="meta">
            <span>{job.organization}</span>
            {job.vacancies ? <span>{job.vacancies} posts</span> : null}
            {job.lastDate ? <span>Last date: {job.lastDate}</span> : null}
            <span class="badge open">Open</span>
            <span class="badge">{job.category || 'general'}</span>
          </div>
        </a>
      ))
    )
  }

  {
    recent.length > 0 ? (
      <>
        <h2>Recently added</h2>
        {recent.map((job) => (
          <a class="job-card" href={`/jobs/${job.slug}`}>
            <h3>{job.title}</h3>
            <div class="meta">
              <span>{job.organization}</span>
              <span>Posted: {job.datePosted}</span>
              <span class="badge">{job.category || 'general'}</span>
            </div>
          </a>
        ))}
      </>
    ) : null
  }

  {
    Object.keys(byCategory).length > 0 ? (
      <h2>Browse by category</h2>
      <div class="meta" style="gap: 0.6rem;">
        {Object.entries(byCategory)
          .sort((a, b) => b[1] - a[1])
          .map(([cat, count]) => (
            <a class="badge" href={`/jobs/?category=${cat}`}>
              {cat} · {count}
            </a>
          ))}
      </div>
    ) : null
  }
</BaseLayout>
