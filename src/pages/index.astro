---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import SectionHead from '../components/SectionHead.astro';
import CategoryTile from '../components/CategoryTile.astro';
import jobs from '../data/jobs.json';
import results from '../data/results.json';
import admits from '../data/admit-cards.json';
import { CATEGORIES, categoryLabel, countByCategory, daysUntil, lastDateLabel } from '../lib/categories.mjs';

const today = new Date().toISOString().slice(0, 10);
const freshSince = new Date(Date.now() - 3 * 86400000).toISOString().slice(0, 10);

const openJobs = jobs
  .filter((j) => !j.lastDate || j.lastDate >= today)
  .sort((a, b) => (a.lastDate || '9999').localeCompare(b.lastDate || '9999'));
const recentJobs = [...jobs]
  .sort((a, b) => (b.datePosted || '').localeCompare(a.datePosted || ''))
  .slice(0, 6);
const recentResults = [...results]
  .sort((a, b) => (b.releaseDate || '').localeCompare(a.releaseDate || ''))
  .slice(0, 5);
const recentAdmits = [...admits]
  .sort((a, b) => (b.releaseDate || '').localeCompare(a.releaseDate || ''))
  .slice(0, 5);

const counts = countByCategory(jobs);
const totalVacancies = jobs.reduce((sum, j) => sum + (Number(j.vacancies) || 0), 0);
const openVacancies = openJobs.reduce((sum, j) => sum + (Number(j.vacancies) || 0), 0);

const jobMeta = (job) => [
  job.organization,
  categoryLabel(job.category),
  job.vacancies ? `${job.vacancies.toLocaleString('en-IN')} posts` : null,
  job.lastDate ? `Last date ${job.lastDate}` : `Posted ${job.datePosted || '—'}`,
];
const isNew = (job) => Boolean(job.datePosted && job.datePosted >= freshSince);
---

<BaseLayout
  title="Latest Government Jobs, Results & Admit Cards"
  description="Free, clean alerts for Indian government jobs, exam results and admit cards — parsed straight from official notifications with eligibility, age limit, vacancy breakdown, fee and dates."
>
  <Fragment slot="hero">
    <h1>Latest government jobs, results &amp; admit cards</h1>
    <p class="lead">
      Official notifications only — each listing carries eligibility, age limit, vacancy split,
      fee, important dates, exam pattern and syllabus.
    </p>
    <div class="hero-actions">
      <a class="btn" href="/jobs/">Latest jobs</a>
      <a class="btn secondary" href="/results/">Results</a>
      <a class="btn secondary" href="/admit-cards/">Admit cards</a>
      <a class="btn secondary" href="/calendar/">Closing soon</a>
    </div>
    <div class="hero-stats">
      <div>
        <strong>{openJobs.length}</strong>
        <span>open jobs</span>
      </div>
      <div>
        <strong>{openVacancies.toLocaleString('en-IN')}</strong>
        <span>open vacancies</span>
      </div>
      <div>
        <strong>{results.length}</strong>
        <span>results</span>
      </div>
      <div>
        <strong>{admits.length}</strong>
        <span>admit cards</span>
      </div>
    </div>
  </Fragment>

  <section>
    <SectionHead title="Latest jobs" href="/jobs/" />
    {
      openJobs.length === 0 && recentJobs.length === 0 ? (
        <p class="notice">
          Notifications are being pulled from official portals right now. Only listings that pass
          the detail checks (dates, eligibility, fee, vacancy) get published — see{' '}
          <a href="/sources">monitored sources</a>.
        </p>
      ) : (
        <div class="stack">
          {(openJobs.length ? openJobs : recentJobs)
            .slice(0, 8)
            .map((job) => (
              <EntryRow
                href={`/jobs/${job.slug}`}
                title={job.title}
                meta={jobMeta(job)}
                badge={lastDateLabel(job.lastDate)?.text || 'Open'}
                badgeTone={lastDateLabel(job.lastDate)?.tone || 'open'}
                snippet={job.qualify || null}
                isNew={isNew(job)}
              />
            ))}
        </div>
      )
    }
  </section>

  {
    recentResults.length > 0 ? (
      <section>
        <SectionHead title="Latest results" href="/results/" />
        <div class="stack">
          {recentResults.map((r) => (
            <EntryRow
              href={`/results/${r.slug}`}
              title={r.title}
              meta={[r.organization, r.releaseDate ? `Released ${r.releaseDate}` : null]}
              badge={r.status || 'declared'}
              badgeTone="open"
            />
          ))}
        </div>
      </section>
    ) : null
  }

  {
    recentAdmits.length > 0 ? (
      <section>
        <SectionHead title="Admit cards" href="/admit-cards/" />
        <div class="stack">
          {recentAdmits.map((a) => (
            <EntryRow
              href={`/admit-cards/${a.slug}`}
              title={a.title}
              meta={[a.organization, a.releaseDate ? `Released ${a.releaseDate}` : null]}
              badge="released"
              badgeTone="open"
            />
          ))}
        </div>
      </section>
    ) : null
  }

  {
    openJobs.length > 0 ? (
      <section>
        <SectionHead title="Closing soon" href="/calendar/" linkLabel="Full calendar" />
        <div class="stack">
          {openJobs.slice(0, 5).map((job) => {
            const label = lastDateLabel(job.lastDate);
            return (
              <EntryRow
                href={`/jobs/${job.slug}`}
                title={job.title}
                meta={[job.organization, job.lastDate ? `Last date ${job.lastDate}` : null]}
                badge={label?.text || 'Open'}
                badgeTone={label?.tone || 'open'}
              />
            );
          })}
        </div>
      </section>
    ) : null
  }

  <section>
    <SectionHead title="Browse by category" href="/categories/" />
    <div class="cat-grid">
      {
        CATEGORIES.filter((c) => c.slug !== 'general' || counts[c.slug]).map((cat) => (
          <CategoryTile
            href={`/jobs/category/${cat.slug}/`}
            label={cat.label}
            blurb={cat.blurb}
            count={counts[cat.slug] || 0}
          />
        ))
      }
    </div>
  </section>

  <section>
    <SectionHead title="How this site stays clean" href="/about/" linkLabel="About us" />
    <div class="trust-grid">
      <div class="trust-item">
        <strong>Official sources only</strong>
        <p>Every page cites a government domain. News aggregators and blogs are blocked by design.</p>
      </div>
      <div class="trust-item">
        <strong>Detail before publish</strong>
        <p>A job is published only when dates, eligibility, fee or vacancy details were parsed from the official notice.</p>
      </div>
      <div class="trust-item">
        <strong>Auto expiry</strong>
        <p>Listings past their last date leave the index and stop being crawled.</p>
      </div>
    </div>
    <p class="muted" style="margin-top: 20px; font-size: 14px;">
      Tracking <strong>{totalVacancies.toLocaleString('en-IN')}</strong> vacancies across
      {jobs.length} notifications · updated automatically from official portals.
    </p>
  </section>
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .trust-item {
    background: var(--parchment);
    border-radius: 14px;
    padding: 18px 20px;
  }

  .trust-item strong {
    display: block;
    font-size: 16px;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  .trust-item p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
</style>
