---
import { SITE } from '../config/constants.mjs';
import { buildWebSiteSchema } from '../lib/schema.mjs';

const {
  title,
  description = SITE.tagline,
  canonicalPath = Astro.url.pathname,
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE.origin).href;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — Official Government Job Notifications`;
const websiteSchema = buildWebSiteSchema();
const hasHero = Astro.slots.has('hero');
const navItems = [
  { href: '/jobs/', label: 'Jobs' },
  { href: '/results/', label: 'Results' },
  { href: '/admit-cards/', label: 'Admit Cards' },
  { href: '/categories/', label: 'Categories' },
  { href: '/calendar/', label: 'Closing Soon' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex,follow' : 'index,follow,max-snippet:-1,max-image-preview:large'}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <header class="global-nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">{SITE.name}</a>
        <nav>
          {navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    {hasHero ? (
      <section class="hero-band">
        <div class="hero-mesh" aria-hidden="true"></div>
        <div class="wrap hero-content">
          <slot name="hero" />
        </div>
      </section>
    ) : null}

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-lead">{SITE.name}</p>
        <p>
          {SITE.name} aggregates official government recruitment notifications. Always apply
          through the official portal linked on each page. This is a private information service
          and is not affiliated with any government body.
        </p>
        <p class="footer-links">
          <a href="/jobs">Jobs</a> · <a href="/results">Results</a> ·
          <a href="/admit-cards">Admit cards</a> · <a href="/categories">Categories</a> ·
          <a href="/calendar">Closing soon</a> · <a href="/sources">Data sources</a> ·
          <a href="/about">About</a> · <a href="/privacy">Privacy</a>
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        --primary: #0070f3;
        --primary-focus: #0761d1;
        --primary-on-dark: #3291ff;
        --cta: #171717;
        --cta-hover: #000000;
        --ink: #171717;
        --body: #4d4d4d;
        --muted: #6f6f6f;
        --faint: #a1a1a1;
        --canvas: #fafafa;
        --elevated: #ffffff;
        --parchment: #f2f2f2;
        --pearl: #fafafa;
        --hairline: #ebebeb;
        --divider: #f2f2f2;
        --tile: #171717;
        --chip: #f2f2f2;
        --link-soft: #d3e5ff;
        --warning-soft: #ffefcf;
        --warning-deep: #ab570a;
        --error-soft: #fdeced;
        --error-deep: #c50000;
        --max: 1000px;
        --radius-card: 12px;
        --radius-sm: 6px;
        --radius-pill: 100px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--elevated);
        color: var(--ink);
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui,
          'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        letter-spacing: -0.16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: var(--primary);
        text-decoration: none;
      }

      a:hover {
        color: var(--primary-focus);
        text-decoration: underline;
      }

      .wrap {
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 24px;
      }

      .global-nav {
        background: rgba(250, 250, 250, 0.86);
        backdrop-filter: saturate(180%) blur(12px);
        -webkit-backdrop-filter: saturate(180%) blur(12px);
        border-bottom: 1px solid var(--hairline);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        min-height: 52px;
        flex-wrap: wrap;
        padding-top: 8px;
        padding-bottom: 8px;
      }

      .brand {
        color: var(--ink);
        font-weight: 600;
        font-size: 15px;
        letter-spacing: -0.32px;
      }

      .brand:hover {
        color: var(--ink);
        text-decoration: none;
      }

      .global-nav nav {
        display: flex;
        gap: 2px;
        flex-wrap: wrap;
      }

      .global-nav nav a {
        color: var(--body);
        font-size: 14px;
        line-height: 20px;
        letter-spacing: -0.28px;
        border-radius: var(--radius-pill);
        padding: 6px 12px;
      }

      .global-nav nav a:hover {
        background: var(--parchment);
        color: var(--ink);
        text-decoration: none;
      }

      main {
        padding: 36px 0 64px;
        min-height: 55vh;
      }

      .hero-band {
        position: relative;
        overflow: hidden;
        background: var(--canvas);
        border-bottom: 1px solid var(--hairline);
        padding: 88px 0 80px;
      }

      .hero-content {
        position: relative;
        z-index: 1;
      }

      .hero-mesh {
        position: absolute;
        inset: -45% -8% auto -8%;
        height: 560px;
        pointer-events: none;
        opacity: 0.5;
        filter: blur(90px);
        background:
          radial-gradient(38% 58% at 12% 42%, #007cf0 0%, rgba(0, 124, 240, 0) 62%),
          radial-gradient(32% 52% at 42% 18%, #00dfd8 0%, rgba(0, 223, 216, 0) 62%),
          radial-gradient(34% 58% at 68% 34%, #7928ca 0%, rgba(121, 40, 202, 0) 62%),
          radial-gradient(28% 48% at 90% 58%, #ff0080 0%, rgba(255, 0, 128, 0) 62%);
      }

      .hero h1 {
        font-size: 48px;
        line-height: 1;
        letter-spacing: -2.4px;
        font-weight: 600;
        margin: 0 0 20px;
        max-width: 18ch;
        color: var(--ink);
      }

      .hero .lead {
        font-size: 18px;
        line-height: 1.55;
        font-weight: 400;
        letter-spacing: -0.16px;
        color: var(--body);
        margin: 0 0 28px;
        max-width: 56ch;
      }

      .hero .hero-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
      }

      .hero .hero-stats {
        display: flex;
        gap: 40px;
        flex-wrap: wrap;
        margin-top: 48px;
        padding-top: 28px;
        border-top: 1px solid var(--hairline);
      }

      .hero .hero-stats div {
        min-width: 120px;
      }

      .hero .hero-stats strong {
        display: block;
        font-size: 36px;
        line-height: 1.1;
        font-weight: 600;
        letter-spacing: -1.4px;
        color: var(--ink);
      }

      .hero .hero-stats span {
        font-size: 13px;
        color: var(--muted);
        letter-spacing: -0.08px;
      }

      h1 {
        font-size: 36px;
        line-height: 1.12;
        font-weight: 600;
        letter-spacing: -1.44px;
        margin: 0 0 12px;
      }

      h2 {
        font-size: 24px;
        line-height: 1.25;
        font-weight: 600;
        letter-spacing: -0.6px;
        margin: 48px 0 16px;
      }

      h3 {
        font-size: 19px;
        line-height: 1.35;
        font-weight: 600;
        letter-spacing: -0.38px;
        margin: 32px 0 8px;
      }

      p {
        margin: 0 0 16px;
      }

      .muted {
        color: var(--muted);
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.43;
        letter-spacing: -0.01em;
        align-items: center;
      }

      .meta a {
        color: var(--muted);
      }

      .meta a:hover {
        color: var(--primary);
      }

      .meta strong {
        color: var(--ink);
        font-weight: 600;
      }

      .panel {
        background: var(--canvas);
        border: 1px solid var(--hairline);
        border-radius: var(--radius-card);
        padding: 24px;
      }

      .panel + .panel {
        margin-top: 16px;
      }

      .band {
        background: var(--parchment);
        border-radius: var(--radius-card);
        padding: 24px;
      }

      .notice {
        background: var(--parchment);
        border-radius: var(--radius-card);
        padding: 16px 20px;
        font-size: 14px;
        line-height: 1.5;
        color: var(--muted);
        letter-spacing: -0.01em;
      }

      .job-card {
        display: block;
        background: var(--canvas);
        border: 1px solid var(--hairline);
        border-radius: var(--radius-card);
        padding: 20px 24px;
        margin-bottom: 16px;
        color: inherit;
        transition: border-color 0.2s ease;
      }

      .job-card:hover {
        border-color: var(--primary);
        text-decoration: none;
      }

      .job-card h3 {
        margin: 0 0 6px;
        font-size: 21px;
        letter-spacing: -0.01em;
      }

      .job-card:hover h3 {
        color: var(--primary);
      }

      .badge {
        display: inline-block;
        background: var(--parchment);
        border-radius: var(--radius-pill);
        padding: 2px 10px;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--body);
        letter-spacing: -0.16px;
        line-height: 1.6;
      }

      .badge.open {
        color: var(--primary);
        background: var(--link-soft);
      }

      .badge.urgent {
        color: var(--error-deep);
        background: var(--error-soft);
      }

      .badge.soon {
        color: var(--warning-deep);
        background: var(--warning-soft);
      }

      .badge.closed {
        color: var(--muted);
        background: var(--parchment);
      }

      .table-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 17px;
        letter-spacing: -0.01em;
      }

      th,
      td {
        text-align: left;
        padding: 12px 0;
        border-bottom: 1px solid var(--divider);
        vertical-align: top;
      }

      th {
        width: 40%;
        padding-right: 20px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 600;
        line-height: 1.43;
      }

      tr:last-child th,
      tr:last-child td {
        border-bottom: none;
      }

      thead th {
        border-bottom: 1px solid var(--hairline);
        color: var(--ink);
        width: auto;
        padding-top: 0;
      }

      thead + tbody tr:first-child th,
      thead + tbody tr:first-child td {
        padding-top: 12px;
      }

      ol,
      ul {
        margin: 0 0 16px;
        padding-left: 22px;
      }

      li {
        margin-bottom: 8px;
      }

      .btn {
        display: inline-block;
        background: var(--cta);
        color: #fff;
        font-size: 15px;
        font-weight: 500;
        letter-spacing: -0.32px;
        border-radius: var(--radius-pill);
        padding: 9px 18px;
        margin: 8px 0;
        border: 1px solid var(--cta);
        transition: background 0.15s ease, border-color 0.15s ease;
      }

      .btn:hover {
        background: var(--cta-hover);
        border-color: var(--cta-hover);
        color: #fff;
        text-decoration: none;
      }

      .btn:active {
        transform: translateY(1px);
      }

      .btn.secondary {
        background: var(--elevated);
        color: var(--ink);
        border: 1px solid var(--hairline);
      }

      .btn.secondary:hover {
        background: var(--parchment);
        color: var(--ink);
      }

      code {
        font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.88em;
        background: var(--parchment);
        padding: 2px 6px;
        border-radius: 6px;
      }

      .site-footer {
        background: var(--canvas);
        border-top: 1px solid var(--hairline);
        color: var(--muted);
        font-size: 12.5px;
        line-height: 1.6;
        letter-spacing: -0.08px;
        padding: 56px 0;
        margin-top: 64px;
      }

      .site-footer a {
        color: var(--primary);
      }

      .footer-lead {
        color: var(--ink);
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
      }

      .footer-links {
        margin-top: 16px;
      }

      @media (max-width: 734px) {
        .hero-band {
          padding: 56px 0 52px;
        }

        .hero h1 {
          font-size: 36px;
          letter-spacing: -1.4px;
        }

        .hero .lead {
          font-size: 17px;
        }

        .hero .hero-stats {
          gap: 24px;
          margin-top: 32px;
        }

        .hero .hero-stats strong {
          font-size: 30px;
        }

        h1 {
          font-size: 30px;
          letter-spacing: -0.9px;
        }

        h2 {
          font-size: 22px;
          margin-top: 40px;
        }

        th {
          width: 44%;
        }
      }

      @media (max-width: 480px) {
        .hero h1 {
          font-size: 32px;
        }

        h1 {
          font-size: 28px;
        }

        .nav-inner {
          justify-content: center;
        }

        .panel,
        .job-card {
          padding: 18px;
        }
      }
    </style>
  </body>
</html>
