---
import { SITE } from '../config/constants.mjs';
import { buildWebSiteSchema } from '../lib/schema.mjs';

const {
  title,
  description = SITE.tagline,
  canonicalPath = Astro.url.pathname,
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE.origin).href;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — Official Government Job Notifications`;
const websiteSchema = buildWebSiteSchema();
const hasHero = Astro.slots.has('hero');
const navItems = [
  { href: '/jobs/', label: 'Jobs' },
  { href: '/results/', label: 'Results' },
  { href: '/admit-cards/', label: 'Admit Cards' },
  { href: '/calendar/', label: 'Deadlines' },
  { href: '/sources/', label: 'Sources' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex,follow' : 'index,follow,max-snippet:-1,max-image-preview:large'}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <header class="global-nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">{SITE.name}</a>
        <nav>
          {navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    {hasHero ? (
      <section class="tile-dark hero">
        <div class="wrap">
          <slot name="hero" />
        </div>
      </section>
    ) : null}

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-lead">{SITE.name}</p>
        <p>
          {SITE.name} aggregates official government recruitment notifications. Always apply
          through the official portal linked on each page. This is a private information service
          and is not affiliated with any government body.
        </p>
        <p class="footer-links">
          <a href="/sources">Our data sources</a> · <a href="/about">About</a> ·
          <a href="/privacy">Privacy</a>
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        --primary: #0066cc;
        --primary-focus: #0071e3;
        --primary-on-dark: #2997ff;
        --ink: #1d1d1f;
        --muted: #7a7a7a;
        --canvas: #ffffff;
        --parchment: #f5f5f7;
        --pearl: #fafafc;
        --hairline: rgba(0, 0, 0, 0.08);
        --divider: #f0f0f0;
        --tile: #272729;
        --chip: #e8e8ed;
        --max: 980px;
        --radius-card: 18px;
        --radius-sm: 8px;
        --radius-pill: 9999px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--canvas);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', system-ui,
          'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 17px;
        line-height: 1.47;
        letter-spacing: -0.01em;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: var(--primary);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .wrap {
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 24px;
      }

      .global-nav {
        background: #000;
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        min-height: 44px;
        flex-wrap: wrap;
        padding-top: 6px;
        padding-bottom: 6px;
      }

      .brand {
        color: #fff;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: -0.12px;
      }

      .brand:hover {
        color: #fff;
        text-decoration: none;
      }

      .global-nav nav {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
      }

      .global-nav nav a {
        color: rgba(255, 255, 255, 0.88);
        font-size: 12px;
        letter-spacing: -0.12px;
      }

      .global-nav nav a:hover {
        color: #fff;
        text-decoration: none;
      }

      main {
        padding: 32px 0 56px;
        min-height: 55vh;
      }

      .tile-dark {
        background: var(--tile);
        color: #fff;
      }

      .tile-dark a {
        color: var(--primary-on-dark);
      }

      .hero {
        padding: 80px 0;
      }

      .hero h1 {
        font-size: 56px;
        line-height: 1.07;
        letter-spacing: -0.028em;
        font-weight: 600;
        margin: 0 0 16px;
        max-width: 16ch;
      }

      .hero .lead {
        font-size: 24px;
        line-height: 1.4;
        font-weight: 400;
        letter-spacing: 0;
        color: #d2d2d7;
        margin: 0 0 24px;
        max-width: 44ch;
      }

      .hero .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
      }

      .hero .hero-stats {
        display: flex;
        gap: 40px;
        flex-wrap: wrap;
        margin-top: 48px;
        padding-top: 32px;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
      }

      .hero .hero-stats div {
        min-width: 120px;
      }

      .hero .hero-stats strong {
        display: block;
        font-size: 40px;
        line-height: 1.1;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #fff;
      }

      .hero .hero-stats span {
        font-size: 14px;
        color: #a1a1a6;
        letter-spacing: -0.01em;
      }

      h1 {
        font-size: 40px;
        line-height: 1.1;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0 0 12px;
      }

      h2 {
        font-size: 28px;
        line-height: 1.2;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin: 48px 0 16px;
      }

      h3 {
        font-size: 21px;
        line-height: 1.3;
        font-weight: 600;
        letter-spacing: 0.01em;
        margin: 32px 0 8px;
      }

      p {
        margin: 0 0 16px;
      }

      .muted {
        color: var(--muted);
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.43;
        letter-spacing: -0.01em;
        align-items: center;
      }

      .meta a {
        color: var(--muted);
      }

      .meta a:hover {
        color: var(--primary);
      }

      .meta strong {
        color: var(--ink);
        font-weight: 600;
      }

      .panel {
        background: var(--canvas);
        border: 1px solid var(--hairline);
        border-radius: var(--radius-card);
        padding: 24px;
      }

      .panel + .panel {
        margin-top: 16px;
      }

      .band {
        background: var(--parchment);
        border-radius: var(--radius-card);
        padding: 24px;
      }

      .notice {
        background: var(--parchment);
        border-radius: var(--radius-card);
        padding: 16px 20px;
        font-size: 14px;
        line-height: 1.5;
        color: var(--muted);
        letter-spacing: -0.01em;
      }

      .job-card {
        display: block;
        background: var(--canvas);
        border: 1px solid var(--hairline);
        border-radius: var(--radius-card);
        padding: 20px 24px;
        margin-bottom: 16px;
        color: inherit;
        transition: border-color 0.2s ease;
      }

      .job-card:hover {
        border-color: var(--primary);
        text-decoration: none;
      }

      .job-card h3 {
        margin: 0 0 6px;
        font-size: 21px;
        letter-spacing: -0.01em;
      }

      .job-card:hover h3 {
        color: var(--primary);
      }

      .badge {
        display: inline-block;
        background: var(--parchment);
        border-radius: var(--radius-pill);
        padding: 3px 12px;
        font-size: 13px;
        font-weight: 600;
        color: #333333;
        letter-spacing: -0.01em;
        line-height: 1.5;
      }

      .badge.open {
        color: var(--primary);
        background: #e8f1fc;
      }

      .badge.closed {
        color: var(--muted);
        background: var(--parchment);
      }

      .table-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 17px;
        letter-spacing: -0.01em;
      }

      th,
      td {
        text-align: left;
        padding: 12px 0;
        border-bottom: 1px solid var(--divider);
        vertical-align: top;
      }

      th {
        width: 40%;
        padding-right: 20px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 600;
        line-height: 1.43;
      }

      tr:last-child th,
      tr:last-child td {
        border-bottom: none;
      }

      thead th {
        border-bottom: 1px solid var(--hairline);
        color: var(--ink);
        width: auto;
        padding-top: 0;
      }

      thead + tbody tr:first-child th,
      thead + tbody tr:first-child td {
        padding-top: 12px;
      }

      ol,
      ul {
        margin: 0 0 16px;
        padding-left: 22px;
      }

      li {
        margin-bottom: 8px;
      }

      .btn {
        display: inline-block;
        background: var(--primary);
        color: #fff;
        font-size: 17px;
        font-weight: 400;
        letter-spacing: -0.01em;
        border-radius: var(--radius-pill);
        padding: 11px 22px;
        margin: 8px 0;
        transition: transform 0.12s ease, background 0.2s ease;
      }

      .btn:hover {
        background: var(--primary-focus);
        color: #fff;
        text-decoration: none;
      }

      .btn:active {
        transform: scale(0.95);
      }

      .btn.secondary {
        background: transparent;
        color: var(--primary);
        border: 1px solid var(--primary);
      }

      .btn.secondary:hover {
        background: rgba(0, 102, 204, 0.06);
      }

      .tile-dark .btn.secondary {
        color: var(--primary-on-dark);
        border-color: var(--primary-on-dark);
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.9em;
        background: var(--parchment);
        padding: 2px 6px;
        border-radius: 6px;
      }

      .site-footer {
        background: var(--parchment);
        color: var(--muted);
        font-size: 12px;
        line-height: 1.6;
        letter-spacing: -0.01em;
        padding: 64px 0;
        margin-top: 64px;
      }

      .site-footer a {
        color: var(--primary);
      }

      .footer-lead {
        color: var(--ink);
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
      }

      .footer-links {
        margin-top: 16px;
      }

      @media (max-width: 734px) {
        .hero {
          padding: 56px 0;
        }

        .hero h1 {
          font-size: 40px;
        }

        .hero .lead {
          font-size: 20px;
        }

        .hero .hero-stats {
          gap: 24px;
          margin-top: 32px;
        }

        .hero .hero-stats strong {
          font-size: 32px;
        }

        h1 {
          font-size: 34px;
        }

        h2 {
          font-size: 24px;
          margin-top: 40px;
        }

        th {
          width: 44%;
        }
      }

      @media (max-width: 480px) {
        .hero h1 {
          font-size: 32px;
        }

        h1 {
          font-size: 28px;
        }

        .nav-inner {
          justify-content: center;
        }

        .panel,
        .job-card {
          padding: 18px;
        }
      }
    </style>
  </body>
</html>
